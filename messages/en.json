	"summary_heading_pages": [
		{
			"declarations": ["input count", "local countPlural = count: plural"],
			"selectors": ["countPlural"],
			"match": {
				"countPlural=one": "You read one page.",
				"countPlural=*": "You read {count} pages."
			}
		}
	],
	"summary_average_speed": "Average speed",
	"summary_accuracy": "Accuracy",
	"unit_wpm": "wpm",
	"summary_pages": "Pages",
