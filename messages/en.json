	"summary_save_pending": [
		{
			"declarations": ["input count", "local countPlural = count: plural"],
			"selectors": ["countPlural"],
			"match": {
				"countPlural=one": "One page will be saved when you're back online.",
				"countPlural=*": "{count} pages will be saved when you're back online."
			}
		}
	],
	"summary_save_failures": [
		{
			"declarations": ["input count", "local countPlural = count: plural"],
			"selectors": ["countPlural"],
			"match": {
				"countPlural=one": "One page couldn't be saved.",
				"countPlural=*": "{count} pages couldn't be saved."
			}
		}
	],
	"summary_sign_in_prompt": "Sign in to save your progress",
	"summary_sign_in_prompt_count": [
		{
			"declarations": ["input count", "local countPlural = count: plural"],
			"selectors": ["countPlural"],
			"match": {
				"countPlural=one": "Sign in to save the page you just typed",
				"countPlural=*": "Sign in to save the {count} pages you just typed"
			}
		}
	],
	"auth_sign_in_google": "Sign in with Google",
	"auth_sign_out": "Sign out",
	"auth_signed_in_as": "Signed in as {name}"
