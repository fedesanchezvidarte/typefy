# Ingestion credentials (scripts/ingest.ts). Copy to .env.ingest, which is gitignored.
#
# The service-role key BYPASSES RLS and can read or destroy every user's data.
# Never commit it, never put it in CI, never prefix it PUBLIC_.

# Local: take these from `npm run db:status`.
SUPABASE_LOCAL_URL=http://127.0.0.1:54321
SUPABASE_LOCAL_SERVICE_ROLE_KEY=

# Production: Supabase dashboard > Project Settings > API.
SUPABASE_PROD_URL=
SUPABASE_PROD_SERVICE_ROLE_KEY=
